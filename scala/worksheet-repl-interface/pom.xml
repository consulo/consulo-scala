<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo.plugin</groupId>
        <artifactId>org.intellij.scala.parent</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <!--
      upstream: a standalone sbt project (build.sbt, needs JDK 17: the implementations are compiled with old Scala versions
      which do not run on newer JDKs), the plugin build takes its two precompiled jars.
      Here the interface (repl-interface/src, pure Java) is compiled by this module - lib/jps/repl-interface.jar, loaded
      with compile-server.jar by CompileEngine. The implementations for the different Scala versions (impls/*/src) are
      still built by the sbt project, the precompiled impls/lib/impls.jar is repackaged by the impls module.
    -->
    <artifactId>org.intellij.scala-worksheet.repl.interface</artifactId>
    <packaging>jar</packaging>

    <build>
        <sourceDirectory>repl-interface/src</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.intellij.scala.worksheet.repl.interfaces</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
