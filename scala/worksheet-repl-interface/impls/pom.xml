<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo.plugin</groupId>
        <artifactId>org.intellij.scala.parent</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>
    <!--
      upstream: scala/worksheet/repl-interface/impls/lib/impls.jar - the REPL interface implementations for the different
      Scala versions, precompiled by the standalone sbt project (../build.sbt, JDK 17). This module repackages the
      precompiled lib/impls.jar, the plugin packages it to lib/worksheet-repl-interface/impls.jar
      (ILoopWrapperFactoryHandler looks for it relative to the interface jar, lib/jps/repl-interface.jar).
    -->
    <artifactId>org.intellij.scala-worksheet.repl.interface.impls</artifactId>
    <packaging>jar</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>unpack-precompiled-impls</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <unzip src="${project.basedir}/lib/impls.jar" dest="${project.build.outputDirectory}">
                                    <patternset>
                                        <exclude name="META-INF/**"/>
                                    </patternset>
                                </unzip>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
