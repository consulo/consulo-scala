    <artifactId>org.intellij.scala-compile.server</artifactId>
    <packaging>jar</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>
            <!-- zinc (sbt incremental compiler) and its Scala 2.13 libraries have no valid JPMS module names;
                 scala-xml and scala-parser-combinators come from scala-impl -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bundle-libraries</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>zinc_2.13,zinc-core_2.13,zinc-apiinfo_2.13,zinc-classpath_2.13,compiler-interface,util-interface,zinc-persist-core-assembly,scala-parallel-collections_2.13,io_2.13,file-tree-views,util-logging_2.13,collections_2.13,util-position_2.13,core-macros_2.13,sjson-new-core_2.13,jline,jansi,jline-terminal,jline-terminal-jni,jline-native,sjson-new-scalajson_2.13,shaded-scalajson_2.13,shaded-jawn-parser_2.13,util-relation_2.13,zinc-persist_2.13,sbinary_2.13,zinc-compile-core_2.13,launcher-interface,zero-allocation-hashing,util-control_2.13,zinc-classfile_2.13</includeArtifactIds>
                            <excludes>META-INF/**,module-info.class</excludes>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

