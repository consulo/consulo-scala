<?xml version="1.0" encoding="iso-8859-1"?>
<idea-plugin>
    <dependencies>
        <module name="intellij.java"/>
        <module name="intellij.java.debugger"/>
        <module name="intellij.java.debugger.impl"/>
        <module name="intellij.java.debugger.impl.shared"/>
        <module name="intellij.java.frontback.psi"/>
        <module name="intellij.java.psi"/>
        <module name="intellij.java.psi.impl"/>
        <module name="intellij.platform.codeStyle"/>
        <module name="intellij.platform.concurrency"/>
        <module name="intellij.platform.core"/>
        <module name="intellij.platform.core.impl"/>
        <module name="intellij.platform.core.ui"/>
        <module name="intellij.platform.debugger"/>
        <module name="intellij.platform.debugger.impl"/>
        <module name="intellij.platform.debugger.impl.shared"/>
        <module name="intellij.platform.editor.ui"/>
        <module name="intellij.platform.eel.provider"/>
        <module name="intellij.platform.ide"/>
        <module name="intellij.platform.ide.core"/>
        <module name="intellij.platform.indexing"/>
        <module name="intellij.platform.indexing.impl"/>
        <module name="intellij.platform.projectModel"/>
        <module name="intellij.platform.util.ui"/>
        <module name="scalaCommunity.compiler-integration-server-management"/>
    </dependencies>

    <extensionPoints>
        <extensionPoint qualifiedName="org.intellij.scala.evaluatorCompileHelper" interface="org.jetbrains.plugins.scala.debugger.evaluation.EvaluatorCompileHelper" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
    </extensions>

    <projectListeners>
        <listener topic="com.intellij.debugger.impl.DebuggerManagerListener"
                  class="org.jetbrains.plugins.scala.debugger.evaluation.ScalaEvaluatorCache"/>

        <listener topic="com.intellij.debugger.impl.DebuggerManagerListener"
                  class="org.jetbrains.plugins.scala.debugger.evaluation.ScalaEvaluatorCompileHelper$Listener"/>

        <listener topic="com.intellij.debugger.impl.DebuggerManagerListener"
                  class="org.jetbrains.plugins.scala.debugger.evaluation.ExpressionCompilerResolverListener"/>
    </projectListeners>
</idea-plugin>
