                            </copy>
                            <copy>
                                <artifact>org.jetbrains.scala:sbt-idea-shell_2.10_0.13:2025.3.0</artifact>
                                <path>repo/org/jetbrains/scala/sbt-idea-shell_2.10_0.13/2025.3.0/sbt-idea-shell_2.10_0.13-2025.3.0.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.jetbrains.scala:sbt-idea-shell_2.10_0.13:pom:2025.3.0</artifact>
                                <path>repo/org/jetbrains/scala/sbt-idea-shell_2.10_0.13/2025.3.0/sbt-idea-shell_2.10_0.13-2025.3.0.pom</path>
                            </copy>
                            <copy>
