                                <path>repo/org/jetbrains/scala/sbt-idea-shell_2.12_1.0/2025.3.0/sbt-idea-shell_2.12_1.0-2025.3.0.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.jetbrains.scala:sbt-idea-shell_2.12_1.0:pom:2025.3.0</artifact>
                                <path>repo/org/jetbrains/scala/sbt-idea-shell_2.12_1.0/2025.3.0/sbt-idea-shell_2.12_1.0-2025.3.0.pom</path>
