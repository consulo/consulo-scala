    <!-- the plugin: plugin.xml and packaging of all modules (the plugin directory is named after this artifactId) -->
    <artifactId>org.intellij.scala</artifactId>
    <packaging>jar</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>consulo.maven</groupId>
                <artifactId>maven-consulo-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <dependencies>
                        <dependency>consulo.java</dependency>
                    </dependencies>
                    <packaging>
                        <skip>${dev.mode}</skip>
                        <version>${build.number}</version>
                        <copies>
                            <!-- loaded with the Scala 3 compiler in its own class loader (Decompiler.classLoader) -->
                            <copy>
                                <artifact>${project.groupId}:org.intellij.scala-semantic.decompiler:${project.version}</artifact>
                                <path>lib/semantic/decompiler.jar</path>
                            </copy>
                            <!-- upstream: merged into runners.jar; runs only in the test JVM (specs2 2.x notifier in the package
                                 of test-runners), must not be loaded by the IDE -->
                            <copy>
                                <artifact>${project.groupId}:org.intellij.scala-test.runners.spec2_2x:${project.version}</artifact>
                                <path>lib/runners/test-runners-spec2_2x.jar</path>
                            </copy>
                            <!-- upstream layout: compile-server.jar, zinc assembly and the interface jars are loaded in
                                 their own class loader (CompileEngine), zinc also needs the interface jars and compiler bridges
                                 as files: SbtData.Jars -->
                            <copy>
                                <artifact>${project.groupId}:org.intellij.scala-compile.server:${project.version}</artifact>
                                <path>lib/jps/compile-server.jar</path>
                            </copy>
                            <copy>
                                <artifact>${project.groupId}:org.intellij.scala-incremental.compiler:${project.version}</artifact>
                                <path>lib/jps/incremental-compiler.jar</path>
                            </copy>
                            <!-- upstream: lib/runners.jar - runs in user JVMs (worksheets, tests), contains the precompiled
                                 MacroPrinter classes in package org.jetbrains.plugins.scala.worksheet, so it can't be a module of the
                                 plugin layer in lib (split package with the worksheet module) -->
                            <copy>
                                <artifact>${project.groupId}:org.intellij.scala-runners:${project.version}</artifact>
                                <path>lib/runners/runners.jar</path>
                            </copy>
                            <!-- upstream: lib/repl-interface.jar and lib/worksheet-repl-interface/impls.jar (the REPL worksheets) -->
                            <copy>
                                <artifact>${project.groupId}:org.intellij.scala-worksheet.repl.interface:${project.version}</artifact>
                                <path>lib/jps/repl-interface.jar</path>
                            </copy>
                            <copy>
                                <artifact>${project.groupId}:org.intellij.scala-worksheet.repl.interface.impls:${project.version}</artifact>
                                <path>lib/worksheet-repl-interface/impls.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.scala-sbt:compiler-interface:1.12.1</artifact>
                                <path>lib/jps/compiler-interface.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.scala-sbt:util-interface:1.12.4</artifact>
                                <path>lib/jps/sbt-interface.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.scala-sbt:compiler-bridge_2.10:jar:sources:1.12.1</artifact>
                                <path>lib/jps/compiler-bridge-sources_2.10.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.scala-sbt:compiler-bridge_2.11:jar:sources:1.12.1</artifact>
                                <path>lib/jps/compiler-bridge-sources_2.11.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.scala-sbt:compiler-bridge_2.12:jar:sources:1.12.1</artifact>
                                <path>lib/jps/compiler-bridge-sources_2.12.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.scala-sbt:compiler-bridge_2.13:jar:sources:1.12.1</artifact>
                                <path>lib/jps/compiler-bridge-sources_2.13.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.scala-lang:scala3-sbt-bridge:3.0.2</artifact>
                                <path>lib/jps/scala3-sbt-bridge_3.0.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.scala-lang:scala3-sbt-bridge:3.1.3</artifact>
                                <path>lib/jps/scala3-sbt-bridge_3.1.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.scala-lang:scala3-sbt-bridge:3.2.2</artifact>
                                <path>lib/jps/scala3-sbt-bridge_3.2.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.scala-lang:scala3-sbt-bridge:3.3.1</artifact>
                                <path>lib/jps/scala3-sbt-bridge_3.3.1.jar</path>
                            </copy>
