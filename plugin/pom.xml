                            </copy>
                            <copy>
                                <artifact>org.jetbrains.scala:sbt-structure-extractor_2.10_0.13:pom:2026.2.7</artifact>
                                <path>repo/org/jetbrains/scala/sbt-structure-extractor_2.10_0.13/2026.2.7/sbt-structure-extractor_2.10_0.13-2026.2.7.pom</path>
                            </copy>
                            <copy>
                                <artifact>org.jetbrains.scala:sbt-structure-extractor_2.12_1.0:2026.2.7</artifact>
                                <path>repo/org/jetbrains/scala/sbt-structure-extractor_2.12_1.0/2026.2.7/sbt-structure-extractor_2.12_1.0-2026.2.7.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.jetbrains.scala:sbt-structure-extractor_2.12_1.0:pom:2026.2.7</artifact>
                                <path>repo/org/jetbrains/scala/sbt-structure-extractor_2.12_1.0/2026.2.7/sbt-structure-extractor_2.12_1.0-2026.2.7.pom</path>
                            </copy>
                            <copy>
                                <artifact>org.jetbrains.scala:sbt-structure-extractor_2.12_1.3:2026.2.7</artifact>
                                <path>repo/org/jetbrains/scala/sbt-structure-extractor_2.12_1.3/2026.2.7/sbt-structure-extractor_2.12_1.3-2026.2.7.jar</path>
                            </copy>
                            <copy>
                                <artifact>org.jetbrains.scala:sbt-structure-extractor_2.12_1.3:pom:2026.2.7</artifact>
                                <path>repo/org/jetbrains/scala/sbt-structure-extractor_2.12_1.3/2026.2.7/sbt-structure-extractor_2.12_1.3-2026.2.7.pom</path>
                            </copy>
                            <copy>
                                <artifact>org.jetbrains.scala:sbt-structure-extractor_sbt2_3:2026.2.7</artifact>
                                <path>repo/org/jetbrains/scala/sbt-structure-extractor_sbt2_3/2026.2.7/sbt-structure-extractor_sbt2_3-2026.2.7.jar</path>
                            </copy>
                            <copy>
