<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo.plugin</groupId>
        <artifactId>org.intellij.scala.parent</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- the plugin: plugin.xml and packaging of all modules (the plugin directory is named after this artifactId) -->
    <artifactId>org.intellij.scala</artifactId>
    <packaging>jar</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>consulo.maven</groupId>
                <artifactId>maven-consulo-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <dependencies>
                        <dependency>consulo.java</dependency>
                    </dependencies>
                    <packaging>
                        <skip>${dev.mode}</skip>
                        <version>${build.number}</version>
                        <copies>
                            <!-- loaded with the Scala 3 compiler in its own class loader (Decompiler.classLoader) -->
                            <copy>
                                <artifact>${project.groupId}:org.intellij.scala-semantic.decompiler:${project.version}</artifact>
                                <path>lib/semantic/decompiler.jar</path>
                            </copy>
                        </copies>
                    </packaging>
                </configuration>
                <executions>
                    <execution>
                        <id>package</id>
                        <phase>package</phase>
                        <goals>
                            <goal>workspace</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>org.intellij.scala-semantic.decompiler</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- the packaging reads the platform version from it -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-application-api</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- packaging takes only direct dependencies - all modules and runtime libraries must be listed here -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>org.intellij.scala-compiler.integration.server.management</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>org.intellij.scala-regexp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>org.intellij.scala-repl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>org.intellij.scala-java.decompiler</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
